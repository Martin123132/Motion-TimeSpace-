8,"additions":4,"deletions":4},"files":[{"sha":"4fa49f9dec514397b3c8daa229d188e4e82193ab","filename":"wide_angle_tools.py","status":"modified","additions":4,"deletions":4,"changes":8,"blob_url":"https://github.com/fbeutler/pk_tools/blob/707eb2a6a4691c34eae19d7f72047ca4892f528e/wide_angle_tools.py","raw_url":"https://github.com/fbeutler/pk_tools/raw/707eb2a6a4691c34eae19d7f72047ca4892f528e/wide_angle_tools.py","contents_url":"https://api.github.com/repos/fbeutler/pk_tools/contents/wide_angle_tools.py?ref=707eb2a6a4691c34eae19d7f72047ca4892f528e","patch":"@@ -56,12 +56,12 @@ def _populate_derivative(d, M, index1, index2, ik, pre_factor, kp_th):\n \t\tnorm = delta_k\n \n \tif ik > 0:\n-\t\tM[index1, index2-1] = -pre_factor*kp_th/(d*norm)\n+\t\tM[index1, index2-1] = -pre_factor*kp_th[ik]/(d*norm)\n \telse:\n-\t\tM[index1, index2] += -pre_factor*kp_th/(d*norm)\n+\t\tM[index1, index2] += -pre_factor*kp_th[ik]/(d*norm)\n \n \tif ik < len(kp_th)-1:\n-\t\tM[index1, index2+1] = pre_factor*kp_th/(d*norm)\n+\t\tM[index1, index2+1] = pre_factor*kp_th[ik]/(d*norm)\n \telse:\n-\t\tM[index1, index2] += pre_factor*kp_th/(d*norm)\n+\t\tM[index1, index2] += pre_factor*kp_th[ik]/(d*norm)\n \treturn M"}]}